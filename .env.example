# Copy to .env and fill in. Never commit .env.

# --- Database (PostGIS) ---
POSTGRES_DB=coastal_morphology_NGT
POSTGRES_USER=coastal
POSTGRES_PASSWORD=change-me-strong
DB_HOST_PORT=5442
# Internal connection string used by backend and geoprocessing (service name "db", port 5432)
DATABASE_URL=postgresql://coastal:change-me-strong@db:5432/coastal_morphology_NGT

# --- Backend (Express) ---
BACKEND_HOST_PORT=3046
NODE_ENV=development
CORS_ORIGIN=http://localhost:5182
TILE_CACHE_SECONDS=300

# --- Geoprocessing (FastAPI) ---
GEO_HOST_PORT=3047
RAW_DATA_DIR=/data/raw
COG_DIR=/data/cog

# --- TiTiler (raster tiles) ---
TITILER_HOST_PORT=3048
# Public URL the browser uses to reach titiler
TITILER_PUBLIC_URL=http://localhost:3048

# --- Frontend (Vite) ---
FRONTEND_HOST_PORT=5182
VITE_API_URL=http://localhost:3046
VITE_TITILER_URL=http://localhost:3048
# Added later by the user
VITE_MAPBOX_TOKEN=
